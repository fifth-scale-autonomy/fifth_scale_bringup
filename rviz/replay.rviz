# outdoor bag 재생용 (launch/replay.launch.py). fusion.rviz 에서 재생에 없는 화면을 빼고 예전 경로를 더함
# 왼쪽 아래 "fusion (YOLO + lidar)": 다시 돌린 정합 결과 (초록 박스 = 라이다와 짝, 빨강 = 짝 없음, + = 라이다 군집)
# 왼쪽 "track (지면 투영)": 흰 띠 검출 (초록 응답, 빨강 중심점, 파랑/노랑 경계, 보라 판단 불가)
Panels:
- Class: rviz_common/Displays
  Help Height: 70
  Name: Displays
  Property Tree Widget:
    Expanded: null
    Splitter Ratio: 0.5
  Tree Height: 254
- Class: rviz_common/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.5
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.6000000238418579
    Cell Size: 1
    Class: rviz_default_plugins/Grid
    Color: 160; 160; 164
    Enabled: true
    Line Style:
      Line Width: 0.029999999329447746
      Value: Lines
    Name: Grid 1m
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 12
    Reference Frame: base_link
    Value: true
  - Alpha: 0.30000001192092896
    Cell Size: 0.10000000149011612
    Class: rviz_default_plugins/Grid
    Color: 90; 90; 94
    Enabled: true
    Line Style:
      Line Width: 0.029999999329447746
      Value: Lines
    Name: Grid 0.1m
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 60
    Reference Frame: base_link
    Value: true
  - Class: rviz_default_plugins/TF
    Enabled: false
    Filter (blacklist): ''
    Filter (whitelist): ''
    Frame Timeout: 15
    Frames:
      All Enabled: true
      base_link:
        Value: true
      camera_link:
        Value: true
      camera_optical_frame:
        Value: true
      laser:
        Value: true
    Marker Scale: 0.5
    Name: TF
    Show Arrows: false
    Show Axes: true
    Show Names: true
    Tree:
      base_link:
        camera_link:
          camera_optical_frame: {}
        laser: {}
    Update Interval: 0
    Value: false
  - Alpha: 1
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/LaserScan
    Color: 0; 255; 0
    Color Transformer: FlatColor
    Decay Time: 0
    Enabled: true
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 4096
    Min Color: 0; 0; 0
    Min Intensity: 0
    Name: scan_filtered
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 3
    Size (m): 0.009999999776482582
    Style: Points
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /scan_filtered
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: vehicle
    Namespaces:
      vehicle: true
    Topic:
      Depth: 2
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /vehicle/markers
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: track (흰 띠 경계)
    Namespaces:
      track: true
    Topic:
      Depth: 2
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /track/markers
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: cones
    Namespaces:
      camera_only: true
      clusters: true
      fused: true
      fused_text: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /cone/markers
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: 새 경로 마커 (콘 좌우, 게이트, 바퀴 자국)
    Namespaces:
      dtr: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /planning/markers
    Value: true
  - Alpha: 1
    Buffer Length: 1
    Class: rviz_default_plugins/Path
    Color: 255; 40; 40
    Enabled: true
    Head Diameter: 0.30000001192092896
    Head Length: 0.20000000298023224
    Length: 0.30000001192092896
    Line Style: Billboards
    Line Width: 0.04
    Name: 예전 경로 (뒤축만 검사, 콘 0.20)
    Offset:
      X: 0
      Y: 0
      Z: 0
    Pose Color: 255; 85; 255
    Pose Style: None
    Radius: 0.029999999329447746
    Shaft Diameter: 0.10000000149011612
    Shaft Length: 0.10000000149011612
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /planning_old/path
    Value: true
  - Alpha: 1
    Buffer Length: 1
    Class: rviz_default_plugins/Path
    Color: 0; 255; 80
    Enabled: true
    Head Diameter: 0.30000001192092896
    Head Length: 0.20000000298023224
    Length: 0.30000001192092896
    Line Style: Billboards
    Line Width: 0.05000000074505806
    Name: 새 경로 (차체 여유 적용)
    Offset:
      X: 0
      Y: 0
      Z: 0
    Pose Color: 255; 85; 255
    Pose Style: None
    Radius: 0.029999999329447746
    Shaft Diameter: 0.10000000149011612
    Shaft Length: 0.10000000149011612
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /planning/path
    Value: true
  - Class: rviz_default_plugins/Image
    Enabled: false
    Max Value: 1
    Median window: 5
    Min Value: 0
    Name: camera (raw)
    Normalize Range: true
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /image_raw
    Value: false
  - Class: rviz_default_plugins/Image
    Enabled: true
    Max Value: 1
    Median window: 5
    Min Value: 0
    Name: fusion (YOLO + lidar)
    Normalize Range: true
    Topic:
      Depth: 2
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /cone/fusion_image
    Value: true
  - Class: rviz_default_plugins/Image
    Enabled: true
    Max Value: 1
    Median window: 5
    Min Value: 0
    Name: track (지면 투영)
    Normalize Range: true
    Topic:
      Depth: 2
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /track/debug_bev
    Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  - Class: rviz_default_plugins/PublishPoint
    Single click: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Angle: -1.5707999467849731
      Class: rviz_default_plugins/TopDownOrtho
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Scale: 55
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
      X: 4
      Y: 0
    Saved: null
Window Geometry:
  Displays:
    collapsed: false
  Height: 1011
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Views:
    collapsed: false
  Width: 1854
  X: 66
  Y: 32
  camera (raw):
    collapsed: false
  fusion (YOLO + lidar):
    collapsed: false
  projection (lidar -> image):
    collapsed: false
  track (지면 투영):
    collapsed: false
